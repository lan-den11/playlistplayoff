# Spotify — client-credentials flow, no user login needed.
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Clerk auth — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres — point this at your Supabase connection string (Settings ->
# Database -> Connection string -> URI; the pooled "Transaction" connection
# on port 6543 works well here). Optional overall — everything using it
# no-ops gracefully without it (see lib/db.js). Backs: profile save/load,
# the live "matchups decided" counter, and waitlist_signups — a plain
# email + signed-up-at list, separate from Clerk's own waitlist records
# (see app/api/waitlist/route.js).
DATABASE_URL=

# Last.fm — optional. Play counts show "not configured" without it.
LASTFM_API_KEY=
LASTFM_USERNAME=

# Public site URL — used for share links/images, robots.txt and the sitemap.
# Falls back to https://playlistplayoff.onrender.com if unset; set this once
# a real domain exists and nothing else needs to change.
NEXT_PUBLIC_SITE_URL=

# PostHog flags this app reads (create these in the PostHog dashboard, not
# here — nothing to set as an env var):
#   app-access-mode              — "waitlist-only" | "hero-only" | "unlocked"
#   homepage-trending-playlist   — payload: a Spotify playlist URL or ID
#   homepage-genre-hiphop-playlist — payload: a Spotify playlist URL or ID
#   homepage-genre-pop-playlist    — payload: a Spotify playlist URL or ID
#   homepage-genre-rock-playlist   — payload: a Spotify playlist URL or ID
# Trending always shows on the homepage (with a hardcoded fallback playlist
# if its flag is unset). Each genre tab only appears once its own flag has a
# non-empty payload — leave any of them unset/blank to hide that tab.
