# Spotify — client-credentials flow, no user login needed.
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Clerk auth — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres — optional. Profile save/load just no-ops without it (see lib/db.js).
DATABASE_URL=

# Last.fm — optional. Play counts show "not configured" without it.
LASTFM_API_KEY=
LASTFM_USERNAME=
